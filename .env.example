DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform
JWT_SECRET=replace-me-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
KUBECONFIG_PATH=~/.kube/config
KUBERNETES_CONTEXT=k3d-student-platform
INGRESS_PORT=8081
MAX_ACTIVE_ENVIRONMENTS_PER_USER=2
DEFAULT_TTL_HOURS=8
JOB_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
JOB_STALE_SECONDS=120
CLEANUP_FAILED_ENVIRONMENTS=false
LOG_LEVEL=INFO
